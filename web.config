<?xml version="1.0" encoding="utf-8"?>
<!-- 
  IIS Configuration for Node.js Express Backend via iisnode
  Requirements: 
  1. IIS URL Rewrite Module 2.1
  2. iisnode (iisnode-full-v0.2.21-x64.msi)
-->
<configuration>
  <system.webServer>
    <!-- Register iisnode handler for server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Rewrite Rules to direct all API requests to server.js -->
    <rewrite>
      <rules>
        <!-- Do not interfere with iisnode log files inspection -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Route all incoming requests through server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security: Exclude sensitive files from direct web access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode settings -->
    <iisnode 
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true"
      watchedFiles="*.js;config\*.js;controllers\*.js;routes\*.js;.env"
    />
  </system.webServer>
</configuration>
